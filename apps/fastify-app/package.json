{
  "name": "@otel-perf/fastify-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify test application for OpenTelemetry performance benchmarking",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "start:baseline": "OTEL_ENABLED=false node dist/index.js",
    "start:otel": "OTEL_ENABLED=true node --import ./dist/instrumentation/otel-tracing.js dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "fastify": "^4.26.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-base": "^1.29.0",
    "@opentelemetry/instrumentation-http": "^0.57.0",
    "@opentelemetry/resources": "^1.29.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/instrumentation-http": "^0.52.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "@opentelemetry/instrumentation-http": {
      "optional": true
    }
  }
}
