{
  "name": "otel-js-performance-experiments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Performance testing project for OpenTelemetry JavaScript",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "cli": "node packages/cli/dist/index.js",
    "benchmark": "npm run cli -- run",
    "compare": "npm run cli -- compare",
    "report": "npm run cli -- report"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "~5.3.0"
  }
}
