{
  "name": "otel-js-performance-experiments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Performance testing project for OpenTelemetry JavaScript",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "cli": "node packages/cli/dist/index.js",
    "benchmark": "npm run cli -- run",
    "compare": "npm run cli -- compare",
    "report": "npm run cli -- report"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "turbo": "^2.0.0",
    "typescript": "~5.3.0",
    "vitest": "^2.0.0"
  }
}
